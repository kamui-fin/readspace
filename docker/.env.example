# Meilisearch Configuration
# Generated by setup.sh during initial setup
MEILISEARCH_MASTER_KEY=your-meilisearch-master-key-here
MEILISEARCH_SEARCH_KEY=your-meilisearch-search-key-here

# Deployment URLs
# These are set by setup.sh based on your access configuration (IP address or custom domain)
API_URL=http://localhost:18008
WEB_URL=http://localhost:18042
SUPABASE_PUBLIC_URL=http://localhost:18000
MEILISEARCH_PUBLIC_URL=http://localhost:7700

# RSSHub Configuration
# Set by setup.sh based on whether you chose local or external RSSHub
# Values: "local" or "external"
RSSHUB_MODE=local
