{
  "name": "@readspace/shared",
  "version": "1.0.0",
  "description": "Shared business logic, API client, and types for Readspace applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hot-toast": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-hot-toast": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@types/node": "^20.16.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "react": "^19",
    "react-dom": "^19",
    "react-hot-toast": "^2.4.1",
    "tsdown": "^0.15.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readspace/readspace.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/readspace/readspace/issues"
  },
  "homepage": "https://github.com/readspace/readspace#readme",
  "keywords": [
    "readspace",
    "shared",
    "api",
    "types",
    "utilities",
    "monorepo"
  ],
  "author": "Readspace Team",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}