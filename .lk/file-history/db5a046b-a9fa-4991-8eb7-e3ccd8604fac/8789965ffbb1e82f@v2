"""Redis-backed caching decorator for expensive operations.

This module provides a decorator for caching function results using Redis,
which provides thread-safety, distributed caching, and persistence benefits
over in-memory caching.
"""
import functools
import hashlib
from typing import Any, Callable

from app.core.redis_cache import RedisCache


def cache_result(ttl: int = 300):
    """Cache function result using Redis with specified TTL in seconds.

    This decorator caches the result of async functions in Redis, providing:
    - Thread-safe distributed caching
    - Automatic expiration after TTL
    - Strong hash algorithm (SHA256) for cache keys
    - No memory leaks or unbounded growth

    Args:
        ttl: Time to live in seconds (default: 300 = 5 minutes)

    Returns:
        Decorator function

    Example:
        @cache_result(ttl=600)
        async def expensive_operation(param: str) -> dict:
            # ... expensive computation ...
            return result
    """
    def decorator(func: Callable) -> Callable:
        @functools.wraps(func)
        async def wrapper(*args, **kwargs):
            # Create cache key from function name and arguments
            # Use SHA256 instead of MD5 for better collision resistance
            key_data = f"{func.__name__}:{args}:{sorted(kwargs.items())}"
            cache_key = f"cache:{hashlib.sha256(key_data.encode()).hexdigest()}"

            # Try to get from cache
            cache = RedisCache()
            cached_result = await cache.get(cache_key)
            if cached_result is not None:
                return cached_result

            # Execute function if not in cache
            result = await func(*args, **kwargs)

            # Store in cache with TTL
            await cache.set(cache_key, result, ttl_seconds=ttl)

            return result
        return wrapper
    return decorator


