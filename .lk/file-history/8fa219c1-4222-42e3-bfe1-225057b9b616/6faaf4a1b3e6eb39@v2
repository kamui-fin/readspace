        return loop.run_until_complete(async_enrich_feed(feed_id=UUID(feed_id)))
    except Exception as exc:
        if self.request.retries < (self.max_retries or 2):
            logger.info(
                f"Retrying feed enrichment task, attempt {self.request.retries + 1}",
                feed_id=feed_id,
            )
