# Readspace Monorepo Environment Variables
# Copy this file to .env and fill in the values

# This file is for any root-level environment variables
# Individual apps have their own .env files:
# - apps/web/.env (generated by docker/setup.sh)
# - server/.env (generated by docker/setup.sh)
# - docker/supabase/.env (generated by docker/setup.sh)

# Development settings
NODE_ENV=development