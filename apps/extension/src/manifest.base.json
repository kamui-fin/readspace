{
  "manifest_version": 3,
  "name": "Readspace",
  "version": "1.1.2",
  "description": "Save articles and follow sites instantly — bring everything you read into your calm, distraction-free Readspace inbox.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs", "storage", "notifications", "identity"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Save to Readspace"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.ts"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/readspace.svg"],
      "matches": ["*://*/*"]
    }
  ]
}
