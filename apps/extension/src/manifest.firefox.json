{
  "background": {
    "scripts": ["src/background.ts"],
    "persistent": false,
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "readspace@readspace.ai",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  }
}
