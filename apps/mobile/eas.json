{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "development",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "preview",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "NODE_OPTIONS": "--max-old-space-size=8192",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "production",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6790224641"
      }
    }
  }
}
