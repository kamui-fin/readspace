{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.3.14",
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "bun": "1.3.14"
    },
    "production": {
      "autoIncrement": true,
      "bun": "1.3.14"
    }
  },
  "submit": {
    "production": {}
  }
}
