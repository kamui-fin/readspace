# Cloud Instance Configuration (Production)
# These are used as the default cloud configuration
# Get these values from your production Supabase project
EXPO_PUBLIC_CLOUD_API_URL=https://api.readspace.ai
EXPO_PUBLIC_CLOUD_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_CLOUD_SUPABASE_ANON_KEY=your-production-anon-key-here

# Local Development / Self-Hosted Configuration (Optional)
# Uncomment these for local development
# EXPO_PUBLIC_SUPABASE_URL=http://localhost:18000
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-here
# EXPO_PUBLIC_API_URL=http://localhost:18008

# Web App URL (used as redirectTo in auth emails so link-clicks land on the right page)
# Local:
EXPO_PUBLIC_WEB_URL=http://localhost:18042
# Production example: EXPO_PUBLIC_WEB_URL=https://app.readspace.ai

# RevenueCat API Keys
# EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-api-key
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-ios-specific-api-key
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-android-specific-api-key
