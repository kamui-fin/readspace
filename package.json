{
  "name": "@readspace/monorepo",
  "version": "1.0.0",
  "description": "Readspace monorepo with shared packages",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "format": "pnpm -r format",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test"
  },
  "keywords": [
    "readspace",
    "rss",
    "monorepo",
    "workspace"
  ],
  "author": "Readspace Team",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "bcrypt"
    ],
    "onlyBuiltDependencies": [
      "@firebase/util",
      "bcrypt",
      "canvas",
      "core-js",
      "es5-ext",
      "esbuild",
      "protobufjs",
      "rxdb",
      "sharp",
      "supabase"
    ],
    "overrides": {
      "pdfjs-dist": "4.4.168"
    }
  }
}